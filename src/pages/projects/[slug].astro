---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { projects, type Project } from '../../data/profile';
export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
interface Props { project: Project }
const { project } = Astro.props;
const sections = [
  { id: 'goal', label: '프로젝트 목표' },
  { id: 'implementation', label: '설계 및 구현' },
  { id: 'troubleshooting', label: 'Troubleshooting' },
  { id: 'results', label: '검증 및 결과' },
  ...(project.videos.length ? [{ id: 'video', label: '동작 동영상' }] : []),
  { id: 'source', label: '소스코드 구조' },
  { id: 'run', label: '실행 방법' },
  ...(project.references.length ? [{ id: 'references', label: '참고 자료' }] : []),
];
---
<BaseLayout title={project.title + ' | 손승원'} description={project.summary}>
  <Header />
  <main id="main" class="container project-page">
    <a class="back-link" href="/#projects">← 프로젝트 목록</a>
    <header class="project-heading">
      <p class="eyebrow">{project.category} · {project.period} · {project.team}</p>
      <h1>{project.title}</h1>
      <p class="lead">{project.summary}</p>
      <div class="tags">{project.stack.map(tag => <span class="tag">{tag}</span>)}</div>
      <div class="contribution"><span>담당 범위</span><p>{project.role}</p></div>
      <div class="actions"><a class="button primary" href={project.repo} target="_blank" rel="noopener noreferrer">GitHub 소스코드 ↗</a>{project.videos.length > 0 && <a class="button" href="#video">동작 동영상</a>}</div>
    </header>
    <div class="article-layout">
      <nav class="toc" aria-label="프로젝트 목차">{sections.map(section => <a href={'#' + section.id}>{section.label}</a>)}</nav>
      <article class="project-body">
        <section id="goal"><h2>프로젝트 목표</h2><p>{project.goal}</p></section>
        <section id="implementation"><h2>설계 및 구현</h2><ul>{project.implementation.map(item => <li>{item}</li>)}</ul></section>
        <section id="troubleshooting"><h2>Troubleshooting</h2><div class="issue-list">{project.troubleshooting.map(issue => <article class="issue"><h3>{issue.title}</h3><dl><div><dt>현상</dt><dd>{issue.observation}</dd></div><div><dt>분석</dt><dd>{issue.cause}</dd></div><div><dt>조치</dt><dd>{issue.action}</dd></div><div><dt>결과·범위</dt><dd>{issue.result}</dd></div></dl></article>)}</div></section>
        <section id="results"><h2>검증 및 결과</h2><ul>{project.results.map(item => <li>{item}</li>)}</ul>{project.images.length > 0 && <div class="gallery">{project.images.map(image => <figure><a href={image.src} target="_blank" rel="noopener noreferrer" aria-label={image.caption + ' 원본 보기'}><img src={image.src} alt={image.caption} loading="lazy" /></a><figcaption>{image.caption}</figcaption></figure>)}</div>}</section>
        {/* 영상이 등록된 프로젝트에 동작 동영상 항목을 표시합니다. */}
        {project.videos.length > 0 && <section id="video"><h2>동작 동영상</h2><div class="video-list">{project.videos.map(video => <figure><div class="video"><iframe src={'https://www.youtube-nocookie.com/embed/' + video.id} title={video.title} loading="lazy" allow="encrypted-media; picture-in-picture; fullscreen" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen /></div><figcaption>{video.title} · <a href={'https://www.youtube.com/watch?v=' + video.id} target="_blank" rel="noopener noreferrer">YouTube에서 보기 ↗</a></figcaption></figure>)}</div></section>}
        <section id="source"><h2>소스코드 구조</h2><p class="version-note">{project.sourceNote}</p><div class="source-tree">{project.structure.map(item => <div><a href={project.repo + '/tree/main/' + item.path} target="_blank" rel="noopener noreferrer"><code>{item.path}</code></a><span>{item.description}</span></div>)}</div><a class="detail-link" href={project.repo} target="_blank" rel="noopener noreferrer">저장소 전체 보기 ↗</a></section>
        <section id="run"><h2>실행 방법</h2><ol>{project.run.map(item => <li>{item}</li>)}</ol></section>
        {project.references.length > 0 && <section id="references"><h2>참고 자료</h2><ul class="reference-list">{project.references.map(reference => <li><a href={reference.href} target="_blank" rel="noopener noreferrer">{reference.label} ↗</a></li>)}</ul></section>}
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>
