---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, projects, coursework, experience, projectCategories } from '../data/profile';
---
<BaseLayout>
  <Header />
  <main id="main" class="container">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="eyebrow">{profile.role}</p>
        <h1 id="intro-title">손승원<br /><span>설계 및 검증 포트폴리오</span></h1>
        <p class="lead">{profile.tagline}</p>
        <div class="actions"><a class="button primary" href="#projects">프로젝트 확인</a><a class="button" href="/coursework/">설계 과제 모음</a></div>
        {/* 이력서 파일이 등록되면 다운로드 링크를 추가합니다. */}
      </div>
      <a class="hero-figure" href="/projects/rv32i-cpu/" aria-label="RV32I CPU 프로젝트 상세 페이지">
        <div class="figure-label"><span>RV32I CPU · APB</span><span aria-hidden="true">↗</span></div>
        <img src="/projects/rv32i-apb-block.png" alt="RV32I CPU와 APB 주변장치의 연결 구조" width="720" height="450" />
        <span class="figure-caption">CPU 설계 · 소프트웨어 실행 · 팀 검증 기록</span>
      </a>
    </section>

    {/* About 및 자격 항목은 내용이 비어 있어 표시를 보류합니다. */}

    <section id="projects" class="section">
      <div class="section-heading"><div><p class="eyebrow">Projects</p><h2>프로젝트</h2></div><p class="section-note">목표·구현·문제 해결·소스코드</p></div>
      <div class="filters" role="group" aria-label="프로젝트 분야 필터" hidden>
        {['전체', ...projectCategories].map((category, index) => <button type="button" data-filter={category} aria-pressed={index === 0}>{category}</button>)}
      </div>
      <p class="visually-hidden" id="project-count" role="status" aria-live="polite">프로젝트 {projects.length}개</p>
      <div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div>
    </section>

    <section id="coursework" class="section course-overview">
      <div><p class="eyebrow">Coursework</p><h2>설계 과제 모음</h2><p class="muted">2026.07–11 · 디지털 설계·검증 및 임베디드 실습 {coursework.length}개</p></div>
      <div class="course-overview-body"><p>Classroom 제출 기록, 발표 자료 및 로컬 실습 소스를 기준으로 정리하였습니다. 과제별 요약 문서와 확인된 소스 경로를 제공합니다.</p><a class="detail-link" href="/coursework/">전체 과제 확인 <span aria-hidden="true">↗</span></a></div>
    </section>

    <section id="experience" class="section">
      <div class="section-heading"><div><p class="eyebrow">Experience & Education</p><h2>경력·교육</h2></div></div>
      <div class="timeline">{experience.map(entry => <article class="timeline-entry"><p class="meta">{entry.period}</p><div><h3>{entry.company}</h3><p>{entry.role}</p>{entry.details.length > 0 && <ul>{entry.details.map(detail => <li>{detail}</li>)}</ul>}</div></article>)}</div>
      {/* 자격 정보는 확인된 항목을 추가한 후 표시합니다. */}
    </section>

    <section id="contact" class="section contact"><div><p class="eyebrow">Contact</p><h2>연락처</h2></div><div><a class="email" href={'mailto:' + profile.email}>{profile.email}</a><div class="social">{profile.links.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div></div></section>
  </main>
  <Footer />
</BaseLayout>
<script>
  const filters = document.querySelector<HTMLElement>('.filters');
  const cards = document.querySelectorAll<HTMLElement>('[data-project-category]');
  const count = document.getElementById('project-count');
  if (filters) filters.hidden = false;
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => {
    button.addEventListener('click', () => {
      document.querySelectorAll('[data-filter]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      let visible = 0;
      cards.forEach(card => {
        card.hidden = button.dataset.filter !== '전체' && card.dataset.projectCategory !== button.dataset.filter;
        if (!card.hidden) visible += 1;
      });
      if (count) count.textContent = '프로젝트 ' + visible + '개';
    });
  });
</script>
