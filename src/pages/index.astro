---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Chevron from '../components/Chevron.astro';
import { profile, skills, projects, coursework, experience, certs } from '../data/profile';
---

<BaseLayout>
  <Header />
  <main id="top">
    <div class="container">
      <section class="hero">
        <p class="eyebrow">{profile.role}</p>
        <h1>안녕하세요,<br />{profile.name}입니다.</h1>
        <p class="tagline">{profile.tagline}</p>
        <div class="cta">
          <a class="btn primary" href="#projects">프로젝트 보기</a>
          {profile.resume && <a class="btn" href={profile.resume} target="_blank">이력서</a>}
        </div>
      </section>

      <section id="about">
        <h2>About</h2>
        {profile.about.map((p) => <p class="about-p">{p}</p>)}
        <div class="skills">
          {
            skills.map((g) => (
              <div class="skill-row">
                <span class="skill-group">{g.group}</span>
                <div class="tags">
                  {g.items.map((s) => (
                    <span class="tag">{s}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section id="projects">
        <div class="section-head">
          <h2>Projects</h2>
          <span class="hint">카드를 누르면 상세 내용이 펼쳐집니다</span>
        </div>
        <div class="stack">
          {projects.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>

      <section id="coursework">
        <h2>Coursework</h2>
        <details>
          <summary>
            <div>
              <strong>설계 과제 모음 ({coursework.length}개)</strong>
              <div class="meta">교육 과정에서 매 주제마다 직접 설계하고 시뮬레이션한 과제들</div>
            </div>
            <Chevron />
          </summary>
          <ul class="details-body course-list">
            {
              coursework.map((c) => (
                <li>
                  <span>{c.title}</span>
                  <span class="meta">{c.date}</span>
                </li>
              ))
            }
          </ul>
        </details>
      </section>

      <section id="experience">
        <h2>Experience</h2>
        <div class="stack">
          {
            experience.map((e) =>
              e.details.length === 0 ? (
                <div class="plain-card">
                  <strong>{e.company}</strong>
                  <div class="meta">
                    {e.role} · {e.period}
                  </div>
                </div>
              ) : (
              <details>
                <summary>
                  <div>
                    <strong>{e.company}</strong>
                    <div class="meta">
                      {e.role} · {e.period}
                    </div>
                  </div>
                  <Chevron />
                </summary>
                <ul class="details-body exp-list">
                  {e.details.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              </details>
              )
            )
          }
        </div>
        <h3 class="sub">Certifications</h3>
        <ul class="certs">
          {
            certs.map((c) => (
              <li>
                <span>{c.title}</span>
                <span class="meta">{c.date}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="contact">
        <h2>Contact</h2>
        <p class="contact-lead">함께 이야기 나누고 싶다면 편하게 연락 주세요.</p>
        <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
        <div class="social">
          {
            profile.links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label} ↗
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </main>
  <footer class="container">© {new Date().getFullYear()} {profile.name}</footer>
</BaseLayout>

<style>
  .hero {
    border-top: none;
    padding: 96px 0 72px;
  }
  .eyebrow {
    color: var(--accent);
    font-weight: 600;
    margin: 0 0 8px;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.25;
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }
  .tagline {
    font-size: 1.1rem;
    color: var(--muted);
    margin: 0 0 28px;
  }
  .cta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .btn {
    padding: 10px 18px;
    border-radius: 10px;
    border: 1px solid var(--border);
    color: var(--text);
    font-weight: 600;
  }
  .btn:hover {
    text-decoration: none;
    border-color: var(--accent);
  }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .about-p {
    margin: 0 0 12px;
  }
  .skills {
    margin-top: 28px;
    display: grid;
    gap: 12px;
  }
  .skill-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 12px;
    align-items: start;
  }
  .skill-group {
    font-size: 0.85rem;
    color: var(--muted);
    padding-top: 1px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hint {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .stack {
    display: grid;
    gap: 12px;
  }
  .meta {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .exp-list {
    margin: 0;
    padding-left: 40px;
  }
  .plain-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 20px;
  }
  .course-list,
  .certs {
    list-style: none;
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 6px;
  }
  .certs {
    padding: 0;
  }
  .course-list li,
  .certs li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .sub {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 36px 0 12px;
  }
  .contact-lead {
    margin: 0 0 8px;
    color: var(--muted);
  }
  .email {
    font-size: clamp(1.2rem, 4vw, 1.6rem);
    font-weight: 700;
    word-break: break-all;
  }
  .social {
    display: flex;
    gap: 18px;
    margin-top: 16px;
    flex-wrap: wrap;
  }
  footer {
    padding-top: 24px;
    padding-bottom: 40px;
    font-size: 0.82rem;
    color: var(--muted);
    border-top: 1px solid var(--border);
  }
</style>

<script>
  // name 그룹은 한 번에 하나만 열린다. 위쪽 카드가 접히면서 줄어든 높이만큼
  // 방금 연 카드가 화면 위로 밀려나므로, 접힘 애니메이션이 끝난 뒤 카드 상단으로 다시 맞춘다.
  const COLLAPSE_MS = 300; // global.css의 ::details-content block-size transition 시간과 맞춤
  const HEADER_OFFSET = 72; // html의 scroll-padding-top과 맞춤

  document.querySelectorAll<HTMLDetailsElement>('details[name="project"]').forEach((d) => {
    const iframe = d.querySelector<HTMLIFrameElement>('.video iframe');

    d.addEventListener('toggle', () => {
      // 접히면 iframe을 비워서 유튜브 재생(소리 포함)을 멈추고, 다시 펼치면 원래 주소로 복원
      if (iframe) {
        if (!d.open) {
          iframe.dataset.src ??= iframe.src;
          iframe.src = 'about:blank';
        } else if (iframe.dataset.src) {
          iframe.src = iframe.dataset.src;
        }
      }

      if (!d.open) return;
      setTimeout(() => {
        if (d.getBoundingClientRect().top < HEADER_OFFSET) {
          d.scrollIntoView({ block: 'start', behavior: 'smooth' });
        }
      }, COLLAPSE_MS + 20);
    });
  });
</script>
