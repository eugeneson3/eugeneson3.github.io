---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Chevron from '../components/Chevron.astro';
import { profile, skills, projects, experience } from '../data/profile';
---

<BaseLayout>
  <Header />
  <main id="top">
    <div class="container">
      <section class="hero">
        <p class="eyebrow">{profile.role}</p>
        <h1>안녕하세요,<br />{profile.name}입니다.</h1>
        <p class="tagline">{profile.tagline}</p>
        <div class="cta">
          <a class="btn primary" href="#projects">프로젝트 보기</a>
          {profile.resume && <a class="btn" href={profile.resume} target="_blank">이력서</a>}
        </div>
      </section>

      <section id="about">
        <h2>About</h2>
        {profile.about.map((p) => <p class="about-p">{p}</p>)}
        <div class="skills">
          {
            skills.map((g) => (
              <div class="skill-row">
                <span class="skill-group">{g.group}</span>
                <div class="tags">
                  {g.items.map((s) => (
                    <span class="tag">{s}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section id="projects">
        <div class="section-head">
          <h2>Projects</h2>
          <span class="hint">카드를 누르면 상세 내용이 펼쳐집니다</span>
        </div>
        <div class="stack">
          {projects.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>

      <section id="experience">
        <h2>Experience</h2>
        <div class="stack">
          {
            experience.map((e) => (
              <details>
                <summary>
                  <div>
                    <strong>{e.company}</strong>
                    <div class="meta">
                      {e.role} · {e.period}
                    </div>
                  </div>
                  <Chevron />
                </summary>
                <ul class="details-body exp-list">
                  {e.details.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              </details>
            ))
          }
        </div>
      </section>

      <section id="contact">
        <h2>Contact</h2>
        <p class="contact-lead">함께 이야기 나누고 싶다면 편하게 연락 주세요.</p>
        <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
        <div class="social">
          {
            profile.links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label} ↗
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </main>
  <footer class="container">© {new Date().getFullYear()} {profile.name}</footer>
</BaseLayout>

<style>
  .hero {
    border-top: none;
    padding: 96px 0 72px;
  }
  .eyebrow {
    color: var(--accent);
    font-weight: 600;
    margin: 0 0 8px;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.25;
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }
  .tagline {
    font-size: 1.1rem;
    color: var(--muted);
    margin: 0 0 28px;
  }
  .cta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .btn {
    padding: 10px 18px;
    border-radius: 10px;
    border: 1px solid var(--border);
    color: var(--text);
    font-weight: 600;
  }
  .btn:hover {
    text-decoration: none;
    border-color: var(--accent);
  }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .about-p {
    margin: 0 0 12px;
  }
  .skills {
    margin-top: 28px;
    display: grid;
    gap: 12px;
  }
  .skill-row {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 12px;
    align-items: start;
  }
  .skill-group {
    font-size: 0.85rem;
    color: var(--muted);
    padding-top: 1px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hint {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 24px;
  }
  .stack {
    display: grid;
    gap: 12px;
  }
  .meta {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .exp-list {
    margin: 0;
    padding-left: 40px;
  }
  .contact-lead {
    margin: 0 0 8px;
    color: var(--muted);
  }
  .email {
    font-size: clamp(1.2rem, 4vw, 1.6rem);
    font-weight: 700;
    word-break: break-all;
  }
  .social {
    display: flex;
    gap: 18px;
    margin-top: 16px;
    flex-wrap: wrap;
  }
  footer {
    padding-top: 24px;
    padding-bottom: 40px;
    font-size: 0.82rem;
    color: var(--muted);
    border-top: 1px solid var(--border);
  }
</style>
