---
import type { Project } from '../data/profile';
interface Props { project: Project }
const { project } = Astro.props;
---
<article class="project-card" data-project-category={project.category}>
  <div class="card-meta"><span>{project.category}</span><span>{project.period} · {project.team}</span></div>
  <h3><a href={'/projects/' + project.slug + '/'}>{project.title}</a></h3>
  <div class="tags">{project.stack.map(tag => <span class="tag">{tag}</span>)}</div>
  <p class="card-description">{project.summary}</p>
  <details class="card-summary">
    <summary>요약 보기 <span aria-hidden="true">＋</span></summary>
    <div class="summary-content">
      <p><strong>담당 범위</strong> {project.role}</p>
      <ul>{project.highlights.map(item => <li>{item}</li>)}</ul>
    </div>
  </details>
  <div class="card-actions">
    <a class="detail-link" href={'/projects/' + project.slug + '/'} aria-label={project.title + ' 상세 페이지'}>상세 페이지 <span aria-hidden="true">↗</span></a>
    <a class="source-link" href={project.repo} target="_blank" rel="noopener noreferrer" aria-label={project.title + ' GitHub 소스코드'}>GitHub</a>
  </div>
</article>
