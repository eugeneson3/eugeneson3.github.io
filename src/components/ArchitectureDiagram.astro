---
import type { Project } from '../data/profile';

interface Props {
  diagram: Project['architectures'][number];
  repository: string;
}

const { diagram, repository } = Astro.props;
---
<figure class="architecture">
  <figcaption class="architecture-heading">
    <h3>{diagram.title}</h3>
    <p>{diagram.description}</p>
  </figcaption>
  <div class="architecture-flow-label">{diagram.flow}</div>
  <ol class="architecture-layers" aria-label={diagram.title + ' 계층 구조'}>
    {diagram.layers.map((layer, index) => (
      <li class:list={['architecture-layer', { 'is-application': index === 0, 'is-hardware': index === diagram.layers.length - 1 }]}>
        <div class="layer-label">{layer.name}</div>
        <div class="layer-nodes">
          {layer.nodes.map(node => (
            <div class="architecture-node">
              {node.path ? (
                <a href={repository + '/tree/main/' + node.path} title={node.path} target="_blank" rel="noopener noreferrer">
                  {node.name}
                  <span class="visually-hidden"> 소스코드 보기</span>
                </a>
              ) : <strong>{node.name}</strong>}
              <span>{node.detail}</span>
            </div>
          ))}
        </div>
      </li>
    ))}
  </ol>
</figure>
